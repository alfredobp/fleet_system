{
  "name": "gis-fleet-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:server": "pnpm --filter @fleet/server run dev",
    "dev:web": "pnpm --filter @fleet/web run dev",
    "build": "pnpm -r run build"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
